{
  "name": "rubicon-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "RUBICON PROTOCOL — 瀏覽器機甲動作遊戲與區網伺服器",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "prestart": "npm run build",
    "start": "node server.js",
    "pretest": "npm run build",
    "test": "node scripts/smoke-test.js",
    "lint": "eslint server.js eslint.config.js scripts src",
    "format": "prettier --write src scripts server.js eslint.config.js",
    "format:check": "prettier --check src scripts server.js eslint.config.js",
    "build:exe": "npm run build && pkg server.js -t node22-win-x64 -o dist/rubicon-server.exe"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@yao-pkg/pkg": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "peerjs": "1.5.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "three": "0.128.0"
  },
  "license": "MIT"
}
